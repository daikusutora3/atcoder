{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Rantest current file (100 cases)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/rantest.py",
            "console": "integratedTerminal",
            "args": [
                "${file}",
                "--auto",
                "--cases",
                "100",
                "--seed",
                "0",
                "--timeout",
                "2",
                "--require-contest-quiet"
            ]
        },
        {
            "name": "Rantest current file (1000 cases)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/rantest.py",
            "console": "integratedTerminal",
            "args": [
                "${file}",
                "--auto",
                "--cases",
                "1000",
                "--seed",
                "0",
                "--timeout",
                "2",
                "--require-contest-quiet"
            ]
        }
    ]
}
